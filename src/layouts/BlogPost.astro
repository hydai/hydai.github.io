---
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';

interface Props {
  title: string;
  date: Date;
  updated?: Date;
  tags?: string[];
  categories?: string[];
  description?: string;
  image?: string;
  readingTime?: number;
  prevPost?: { slug: string; title: string };
  nextPost?: { slug: string; title: string };
}

const {
  title,
  date,
  updated,
  tags = [],
  categories = [],
  description,
  image,
  readingTime,
  prevPost,
  nextPost,
} = Astro.props;

// Use UTC to avoid timezone-related date shifts
const formattedDate = `${date.getUTCFullYear()} 年 ${date.getUTCMonth() + 1} 月 ${date.getUTCDate()} 日`;

const formattedUpdated = updated
  ? `${updated.getUTCFullYear()} 年 ${updated.getUTCMonth() + 1} 月 ${updated.getUTCDate()} 日`
  : undefined;
---

<BaseLayout title={title} description={description} image={image}>
  <article class="max-w-3xl mx-auto px-4 py-12">
    <!-- Post header with sunburst -->
    <header class="mb-10 sunburst py-8 text-center">
      <h1
        class="text-4xl md:text-6xl font-display uppercase tracking-widest text-gold leading-tight mb-6"
      >
        {title}
      </h1>
      <div class="flex flex-wrap items-center justify-center gap-3 text-sm font-body uppercase tracking-wide text-pewter">
        <time datetime={date.toISOString()}>
          {formattedDate}
        </time>
        {formattedUpdated && (
          <span>&#9670; 更新於 {formattedUpdated}</span>
        )}
        {readingTime && (
          <span>&#9670; {readingTime} min read</span>
        )}
      </div>
      {tags.length > 0 && (
        <div class="mt-4 flex justify-center">
          <TagList tags={tags} />
        </div>
      )}
    </header>

    <!-- Table of Contents -->
    <nav id="toc" class="mb-10 p-4 deco-card deco-corners">
      <details open>
        <summary class="cursor-pointer font-display text-gold uppercase tracking-wider text-sm">
          Table of Contents
        </summary>
        <div id="toc-content" class="mt-3 text-sm space-y-1"></div>
      </details>
    </nav>

    <!-- Post content -->
    <div
      class="prose prose-lg max-w-none
        prose-headings:font-display prose-headings:uppercase prose-headings:tracking-widest
        prose-a:text-gold prose-a:no-underline hover:prose-a:underline"
    >
      <slot />
    </div>

    <!-- Post navigation -->
    <nav class="mt-16 pt-8 border-t-2 border-gold/30 grid grid-cols-1 md:grid-cols-2 gap-4">
      {prevPost && (
        <a
          href={`/${prevPost.slug}/`}
          class="group deco-card p-4 hover:-translate-y-1"
        >
          <span class="text-xs font-body uppercase tracking-wider text-pewter">&larr; Previous</span>
          <p class="mt-1 font-display uppercase tracking-wider text-champagne group-hover:text-gold transition-colors">
            {prevPost.title}
          </p>
        </a>
      )}
      {nextPost && (
        <a
          href={`/${nextPost.slug}/`}
          class="group deco-card p-4 hover:-translate-y-1 md:text-right md:col-start-2"
        >
          <span class="text-xs font-body uppercase tracking-wider text-pewter">Next &rarr;</span>
          <p class="mt-1 font-display uppercase tracking-wider text-champagne group-hover:text-gold transition-colors">
            {nextPost.title}
          </p>
        </a>
      )}
    </nav>

    <!-- Utterances comments -->
    <section class="mt-12">
      <h2 class="text-xl font-display uppercase tracking-widest text-gold mb-4">Comments</h2>
      <div id="utterances-container"></div>
      <script is:inline>
        (function () {
          var script = document.createElement('script');
          script.src = 'https://utteranc.es/client.js';
          script.setAttribute('repo', 'hydai/hydai.github.io');
          script.setAttribute('issue-term', 'pathname');
          script.setAttribute('theme', 'github-dark');
          script.setAttribute('crossorigin', 'anonymous');
          script.async = true;
          document.getElementById('utterances-container').appendChild(script);
        })();
      </script>
    </section>
  </article>

  <!-- TOC generation script -->
  <script is:inline>
    (function () {
      var article = document.querySelector('article .prose');
      var tocContent = document.getElementById('toc-content');
      if (!article || !tocContent) return;

      var headings = article.querySelectorAll('h2, h3');
      if (headings.length === 0) {
        document.getElementById('toc')?.remove();
        return;
      }

      var list = document.createElement('ul');
      list.className = 'list-none pl-0 space-y-1';

      headings.forEach(function (heading) {
        if (!heading.id) {
          heading.id = heading.textContent
            .trim()
            .toLowerCase()
            .replace(/[^\w\u4e00-\u9fff]+/g, '-')
            .replace(/^-|-$/g, '');
        }
        var li = document.createElement('li');
        var a = document.createElement('a');
        a.href = '#' + heading.id;
        a.textContent = heading.textContent;
        a.className =
          'text-pewter hover:text-gold transition-colors no-underline';
        if (heading.tagName === 'H3') {
          li.className = 'pl-4 border-l border-gold/30';
        }
        li.appendChild(a);
        list.appendChild(li);
      });

      tocContent.appendChild(list);
    })();
  </script>
</BaseLayout>
