---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPostSlug } from '../lib/utils';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Group by year (using UTC to match frontmatter dates)
const postsByYear = new Map<number, typeof posts>();
posts.forEach((post) => {
  const year = post.data.date.getUTCFullYear();
  if (!postsByYear.has(year)) postsByYear.set(year, []);
  postsByYear.get(year)!.push(post);
});
---

<BaseLayout title="Archives">
  <div class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl md:text-4xl font-bold text-text mb-2">Archives</h1>
    <p class="text-sm text-muted mb-10">
      {posts.length} posts total
    </p>

    {
      [...postsByYear.entries()].map(([year, yearPosts]) => (
        <section class="mb-10">
          <h2 id={year} class="text-2xl font-bold text-text mb-4 sticky top-16 scroll-mt-20 bg-bg/90 py-2 z-10 backdrop-blur-sm border-b border-border">
            {year}
          </h2>
          <ul class="space-y-3 border-l-2 border-border pl-6">
            {yearPosts.map((post) => {
              const date = post.data.date;
              const dateStr = `${String(date.getUTCMonth() + 1).padStart(2, '0')}-${String(date.getUTCDate()).padStart(2, '0')}`;
              return (
                <li class="relative">
                  <span class="absolute -left-[25px] top-2 w-2 h-2 rounded-full bg-muted" />
                  <a
                    href={`/${getPostSlug(post)}/`}
                    class="group block"
                  >
                    <span class="font-mono text-sm text-muted">
                      {dateStr}
                    </span>
                    <span class="ml-3 text-text group-hover:text-accent transition-colors">
                      {post.data.title}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
