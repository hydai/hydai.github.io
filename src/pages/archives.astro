---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPostSlug } from '../lib/utils';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Group by year (using UTC to match frontmatter dates)
const postsByYear = new Map<number, typeof posts>();
posts.forEach((post) => {
  const year = post.data.date.getUTCFullYear();
  if (!postsByYear.has(year)) postsByYear.set(year, []);
  postsByYear.get(year)!.push(post);
});
---

<BaseLayout title="Archives">
  <div class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-8 font-mono text-gray-900 dark:text-text-primary">
      <span class="text-blue-600 dark:text-accent-cyan">$</span> Archives
    </h1>
    <p class="text-sm text-gray-500 dark:text-text-secondary mb-8 font-mono">
      {posts.length} posts total
    </p>

    {
      [...postsByYear.entries()].map(([year, yearPosts]) => (
        <section class="mb-10">
          <h2 class="text-2xl font-bold font-mono text-gray-900 dark:text-accent-cyan mb-4 sticky top-16 bg-white/90 dark:bg-bg/90 py-2 z-10 backdrop-blur-sm">
            {year}
          </h2>
          <ul class="space-y-3 border-l-2 border-gray-200 dark:border-text-dim pl-6">
            {yearPosts.map((post) => {
              const date = post.data.date;
              const dateStr = `${String(date.getUTCMonth() + 1).padStart(2, '0')}-${String(date.getUTCDate()).padStart(2, '0')}`;
              return (
                <li class="relative">
                  <span class="absolute -left-[29px] top-2 w-3 h-3 rounded-full bg-gray-300 dark:bg-text-dim border-2 border-white dark:border-bg" />
                  <a
                    href={`/${getPostSlug(post)}/`}
                    class="group block"
                  >
                    <span class="font-mono text-sm text-gray-500 dark:text-text-secondary">
                      {dateStr}
                    </span>
                    <span class="ml-3 text-gray-900 dark:text-text-primary group-hover:text-blue-600 dark:group-hover:text-accent-cyan transition-colors">
                      {post.data.title}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
