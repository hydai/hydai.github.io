---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPostSlug } from '../lib/utils';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Group by year (using UTC to match frontmatter dates)
const postsByYear = new Map<number, typeof posts>();
posts.forEach((post) => {
  const year = post.data.date.getUTCFullYear();
  if (!postsByYear.has(year)) postsByYear.set(year, []);
  postsByYear.get(year)!.push(post);
});
---

<BaseLayout title="Archives">
  <div class="max-w-3xl mx-auto px-4 py-12">
    <!-- Sunburst hero heading -->
    <div class="sunburst py-8 text-center mb-8">
      <h1 class="text-4xl md:text-6xl font-display text-gold uppercase tracking-widest">Archives</h1>
      <p class="text-sm text-pewter mt-3 font-body uppercase tracking-wider">
        {posts.length} posts total
      </p>
    </div>

    {
      [...postsByYear.entries()].map(([year, yearPosts]) => (
        <section class="mb-10">
          <h2 class="text-2xl font-display text-gold uppercase tracking-widest mb-4 sticky top-20 bg-obsidian/90 py-2 z-10 backdrop-blur-sm border-b-2 border-gold/50">
            {year}
          </h2>
          <ul class="space-y-3 border-l-[3px] border-gold/40 pl-6">
            {yearPosts.map((post) => {
              const date = post.data.date;
              const dateStr = `${String(date.getUTCMonth() + 1).padStart(2, '0')}-${String(date.getUTCDate()).padStart(2, '0')}`;
              return (
                <li class="relative">
                  <span class="absolute -left-[30px] top-2 w-3 h-3 bg-gold rotate-45" />
                  <a
                    href={`/${getPostSlug(post)}/`}
                    class="group block"
                  >
                    <span class="font-body text-sm text-pewter uppercase tracking-wider">
                      {dateStr}
                    </span>
                    <span class="ml-3 text-champagne group-hover:text-gold transition-colors">
                      {post.data.title}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
