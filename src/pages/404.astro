---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 Not Found">
  <div class="max-w-3xl mx-auto px-4 py-24 text-center">
    <div class="font-mono">
      <p class="text-6xl font-bold text-blue-600 dark:text-accent-cyan mb-4">404</p>
      <p class="text-xl text-gray-600 dark:text-text-secondary mb-2">Page Not Found</p>
      <div class="mt-8 inline-block p-6 rounded-xl border border-gray-200 dark:border-text-dim bg-gray-50 dark:bg-bg-surface text-left">
        <p class="text-sm text-gray-600 dark:text-text-secondary">
          <span class="text-blue-600 dark:text-accent-cyan">$</span> curl -I <span class="text-gray-900 dark:text-text-primary">{Astro.url.pathname}</span>
        </p>
        <p class="text-sm text-red-500 dark:text-accent-pink mt-1">
          HTTP/1.1 404 Not Found
        </p>
      </div>
      <div class="mt-8">
        <a
          href="/"
          class="inline-block px-6 py-3 rounded-lg bg-blue-600 dark:bg-accent-cyan text-white dark:text-bg font-medium hover:opacity-90 transition-opacity"
        >
          &larr; Back to Home
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
