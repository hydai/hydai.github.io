---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 Not Found">
  <div class="max-w-3xl mx-auto px-4 py-24 text-center">
    <p class="text-8xl font-bold text-muted mb-4">404</p>
    <p class="text-xl text-muted mb-8">Page Not Found</p>
    <div class="inline-block card p-6 text-left mb-8">
      <p class="text-sm text-muted">
        The page <span class="text-text">{Astro.url.pathname}</span> could not be found.
      </p>
    </div>
    <div>
      <a
        href="/"
        class="inline-block px-6 py-3 rounded-lg bg-accent text-bg font-medium hover:opacity-90 transition-opacity"
      >
        &larr; Back to Home
      </a>
    </div>
  </div>
</BaseLayout>
