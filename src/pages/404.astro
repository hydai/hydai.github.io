---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 Not Found">
  <div class="max-w-3xl mx-auto px-4 py-24 text-center">
    <div class="sunburst py-12">
      <p class="text-9xl font-display text-gold mb-4">404</p>
      <p class="text-xl text-pewter font-body uppercase tracking-wider mb-2">Page Not Found</p>
      <div class="mt-8 inline-block deco-card deco-corners p-6 text-left">
        <p class="text-sm text-pewter font-body">
          The page <span class="text-champagne">{Astro.url.pathname}</span> could not be found.
        </p>
      </div>
      <div class="mt-8">
        <a
          href="/"
          class="inline-block px-6 py-3 bg-gold text-obsidian font-display uppercase tracking-wider hover:bg-champagne transition-colors"
        >
          &larr; Back to Home
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
