---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="About hydai">
  <div class="max-w-3xl mx-auto px-4 py-12">
    <!-- Terminal-style header -->
    <div class="mb-10 p-6 rounded-xl border border-gray-200 dark:border-text-dim bg-gray-50 dark:bg-bg-surface font-mono">
      <div class="flex items-center gap-2 mb-4">
        <span class="w-3 h-3 rounded-full bg-red-500"></span>
        <span class="w-3 h-3 rounded-full bg-yellow-500"></span>
        <span class="w-3 h-3 rounded-full bg-green-500"></span>
        <span class="ml-2 text-xs text-gray-500 dark:text-text-secondary">terminal</span>
      </div>
      <p class="text-sm text-gray-600 dark:text-text-secondary">
        <span class="text-blue-600 dark:text-accent-cyan">$</span> whoami
      </p>
      <p class="text-lg font-bold text-gray-900 dark:text-accent-cyan mt-1">hydai</p>
    </div>

    <!-- Avatar and intro -->
    <div class="flex flex-col md:flex-row items-center md:items-start gap-8 mb-12">
      <img
        src="/images/avatar.jpg"
        alt="hydai"
        class="w-32 h-32 rounded-full object-cover border-4 border-gray-200 dark:border-accent-cyan/30 shadow-lg shrink-0"
      />
      <div class="text-center md:text-left">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-text-primary">hydai</h1>
        <p class="text-lg text-gray-600 dark:text-text-secondary mt-1 font-mono">
          讀作海帶<span class="text-sm">(ハイ ダイ)</span>
        </p>
        <p class="mt-3 text-gray-700 dark:text-text-primary leading-relaxed">
          一個興趣使然的軟體工程師
        </p>
      </div>
    </div>

    <!-- Roles & Projects -->
    <section class="mb-12">
      <h2 class="text-xl font-bold mb-4 text-gray-900 dark:text-text-primary font-mono">
        <span class="text-blue-600 dark:text-accent-cyan">#</span> Roles &amp; Projects
      </h2>
      <div class="space-y-3">
        <a
          href="https://github.com/WasmEdge/WasmEdge"
          target="_blank"
          rel="noopener noreferrer"
          class="block p-4 rounded-xl border border-gray-200 dark:border-text-dim bg-gray-50 dark:bg-bg-surface hover:border-blue-500 dark:hover:border-accent-cyan transition-colors group"
        >
          <span class="font-semibold text-gray-900 dark:text-text-primary group-hover:text-blue-600 dark:group-hover:text-accent-cyan transition-colors">WasmEdge Maintainer</span>
        </a>
        <a
          href="https://www.cncf.io/people/ambassadors/"
          target="_blank"
          rel="noopener noreferrer"
          class="block p-4 rounded-xl border border-gray-200 dark:border-text-dim bg-gray-50 dark:bg-bg-surface hover:border-blue-500 dark:hover:border-accent-cyan transition-colors group"
        >
          <span class="font-semibold text-gray-900 dark:text-text-primary group-hover:text-blue-600 dark:group-hover:text-accent-cyan transition-colors">CNCF Ambassador</span>
        </a>
        <a
          href="https://solidity.tw"
          target="_blank"
          rel="noopener noreferrer"
          class="block p-4 rounded-xl border border-gray-200 dark:border-text-dim bg-gray-50 dark:bg-bg-surface hover:border-blue-500 dark:hover:border-accent-cyan transition-colors group"
        >
          <span class="font-semibold text-gray-900 dark:text-text-primary group-hover:text-blue-600 dark:group-hover:text-accent-cyan transition-colors">solidity.tw</span>
          <span class="text-sm text-gray-500 dark:text-text-secondary ml-2">寫作計畫</span>
        </a>
      </div>
    </section>

    <!-- FF14 -->
    <section class="mb-12">
      <h2 class="text-xl font-bold mb-4 text-gray-900 dark:text-text-primary font-mono">
        <span class="text-blue-600 dark:text-accent-purple">#</span> Final Fantasy XIV
      </h2>
      <div class="p-4 rounded-xl border border-gray-200 dark:border-text-dim bg-gray-50 dark:bg-bg-surface space-y-2 font-mono text-sm">
        <p class="text-gray-700 dark:text-text-primary">
          <span class="text-gray-500 dark:text-text-secondary">Global:</span> Hydai Meow<span class="text-gray-400 dark:text-text-dim">@Typhon</span>
        </p>
        <p class="text-gray-700 dark:text-text-primary">
          <span class="text-gray-500 dark:text-text-secondary">FF14TC:</span> 海帶芽<span class="text-gray-400 dark:text-text-dim">@鳳凰</span>
        </p>
        <a
          href="https://ff14.tw"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block text-blue-600 dark:text-accent-cyan hover:underline"
        >
          ff14.tw
        </a>
      </div>
    </section>

    <!-- Social links -->
    <section>
      <h2 class="text-xl font-bold mb-4 text-gray-900 dark:text-text-primary font-mono">
        <span class="text-blue-600 dark:text-accent-cyan">#</span> Connect
      </h2>
      <div class="flex flex-wrap gap-3">
        {[
          { href: 'https://github.com/hydai', label: 'GitHub' },
          { href: 'https://x.com/hydai_tw', label: 'X (Twitter)' },
          { href: 'https://www.youtube.com/@hydai', label: 'YouTube' },
          { href: 'https://www.facebook.com/hungyingdai', label: 'Facebook' },
          { href: 'mailto:hydai@hyd.ai', label: 'Email' },
        ].map(({ href, label }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-4 py-2 rounded-lg text-sm font-medium border border-gray-200 dark:border-text-dim text-gray-700 dark:text-text-secondary hover:border-blue-500 dark:hover:border-accent-cyan hover:text-blue-600 dark:hover:text-accent-cyan transition-colors"
          >
            {label}
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
