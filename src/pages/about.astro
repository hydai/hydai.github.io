---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="About hydai">
  <div class="max-w-3xl mx-auto px-4 py-12">
    <!-- Header -->
    <h1 class="text-3xl md:text-4xl font-bold text-text mb-10">About</h1>

    <!-- Avatar and intro -->
    <div class="flex flex-col md:flex-row items-center md:items-start gap-8 mb-12">
      <!-- Round avatar -->
      <div class="rounded-full border-2 border-border w-32 h-32 overflow-hidden shrink-0">
        <img
          src="/images/avatar.jpg"
          alt="hydai"
          class="w-32 h-32 object-cover"
        />
      </div>
      <div class="text-center md:text-left">
        <h2 class="text-3xl font-semibold text-text">hydai</h2>
        <p class="text-lg text-muted mt-1">
          讀作海帶<span class="text-sm">(ハイ ダイ)</span>
        </p>
        <p class="mt-3 text-text leading-relaxed">
          一個興趣使然的軟體工程師
        </p>
      </div>
    </div>

    <!-- Roles & Projects -->
    <section class="mb-12">
      <h2 class="text-xl font-semibold text-text mb-4">
        Roles &amp; Projects
      </h2>
      <div class="space-y-3">
        <a
          href="https://github.com/WasmEdge/WasmEdge"
          target="_blank"
          rel="noopener noreferrer"
          class="block card p-4 group"
        >
          <span class="font-medium text-text group-hover:text-accent transition-colors">WasmEdge Maintainer</span>
        </a>
        <a
          href="https://www.cncf.io/people/ambassadors/"
          target="_blank"
          rel="noopener noreferrer"
          class="block card p-4 group"
        >
          <span class="font-medium text-text group-hover:text-accent transition-colors">CNCF Ambassador</span>
        </a>
        <a
          href="https://solidity.tw"
          target="_blank"
          rel="noopener noreferrer"
          class="block card p-4 group"
        >
          <span class="font-medium text-text group-hover:text-accent transition-colors">solidity.tw</span>
          <span class="text-sm text-muted ml-2">寫作計畫</span>
        </a>
      </div>
    </section>

    <!-- FF14 -->
    <section class="mb-12">
      <h2 class="text-xl font-semibold text-text mb-4">
        Final Fantasy XIV
      </h2>
      <div class="card p-4 space-y-2 text-sm">
        <p class="text-text">
          <span class="text-accent font-medium">Global:</span> Hydai Meow<span class="text-muted">@Typhon</span>
        </p>
        <p class="text-text">
          <span class="text-accent font-medium">FF14TC:</span> 海帶芽<span class="text-muted">@鳳凰</span>
        </p>
        <a
          href="https://ff14.tw"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block text-accent hover:underline"
        >
          ff14.tw
        </a>
      </div>
    </section>

    <!-- Social links -->
    <section>
      <h2 class="text-xl font-semibold text-text mb-4">
        Connect
      </h2>
      <div class="flex flex-wrap gap-3">
        {[
          { href: 'https://github.com/hydai', label: 'GitHub' },
          { href: 'https://x.com/hydai_tw', label: 'X (Twitter)' },
          { href: 'https://www.youtube.com/@hydai', label: 'YouTube' },
          { href: 'https://www.facebook.com/hungyingdai', label: 'Facebook' },
          { href: 'mailto:hydai@hyd.ai', label: 'Email' },
        ].map(({ href, label }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-4 py-2 text-sm rounded-lg border border-border text-muted hover:bg-elevated hover:text-text transition-colors"
          >
            {label}
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
