---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="About hydai">
  <div class="max-w-3xl mx-auto px-4 py-12">
    <!-- Art Deco hero header -->
    <div class="sunburst py-12 text-center mb-12">
      <h1 class="text-4xl md:text-6xl font-display text-gold uppercase tracking-widest">About</h1>
      <div class="deco-divider mt-6">
        <span>&#9670;</span>
      </div>
    </div>

    <!-- Avatar and intro -->
    <div class="flex flex-col md:flex-row items-center md:items-start gap-8 mb-12">
      <!-- Diamond avatar frame -->
      <div class="border-2 border-gold rotate-45 w-32 h-32 overflow-hidden shrink-0">
        <img
          src="/images/avatar.jpg"
          alt="hydai"
          class="-rotate-45 scale-[1.414] w-32 h-32 object-cover"
        />
      </div>
      <div class="text-center md:text-left">
        <h2 class="text-3xl font-display uppercase tracking-widest text-gold">hydai</h2>
        <p class="text-lg text-pewter mt-1 font-body">
          讀作海帶<span class="text-sm">(ハイ ダイ)</span>
        </p>
        <p class="mt-3 text-champagne leading-relaxed">
          一個興趣使然的軟體工程師
        </p>
      </div>
    </div>

    <!-- Roles & Projects -->
    <section class="mb-12">
      <h2 class="text-xl font-display uppercase tracking-widest text-gold mb-4 flex items-center gap-3">
        <span class="inline-block w-2 h-2 bg-gold rotate-45"></span>
        Roles &amp; Projects
      </h2>
      <div class="space-y-3">
        <a
          href="https://github.com/WasmEdge/WasmEdge"
          target="_blank"
          rel="noopener noreferrer"
          class="block deco-card p-4 hover:-translate-y-1 group"
        >
          <span class="font-display uppercase tracking-wider text-champagne group-hover:text-gold transition-colors">WasmEdge Maintainer</span>
        </a>
        <a
          href="https://www.cncf.io/people/ambassadors/"
          target="_blank"
          rel="noopener noreferrer"
          class="block deco-card p-4 hover:-translate-y-1 group"
        >
          <span class="font-display uppercase tracking-wider text-champagne group-hover:text-gold transition-colors">CNCF Ambassador</span>
        </a>
        <a
          href="https://solidity.tw"
          target="_blank"
          rel="noopener noreferrer"
          class="block deco-card p-4 hover:-translate-y-1 group"
        >
          <span class="font-display uppercase tracking-wider text-champagne group-hover:text-gold transition-colors">solidity.tw</span>
          <span class="text-sm text-pewter ml-2">寫作計畫</span>
        </a>
      </div>
    </section>

    <!-- FF14 -->
    <section class="mb-12">
      <h2 class="text-xl font-display uppercase tracking-widest text-gold mb-4 flex items-center gap-3">
        <span class="inline-block w-2 h-2 bg-gold rotate-45"></span>
        Final Fantasy XIV
      </h2>
      <div class="deco-card p-4 space-y-2 text-sm">
        <p class="text-champagne">
          <span class="text-gold uppercase tracking-wider font-body">Global:</span> Hydai Meow<span class="text-pewter">@Typhon</span>
        </p>
        <p class="text-champagne">
          <span class="text-gold uppercase tracking-wider font-body">FF14TC:</span> 海帶芽<span class="text-pewter">@鳳凰</span>
        </p>
        <a
          href="https://ff14.tw"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block text-gold hover:underline"
        >
          ff14.tw
        </a>
      </div>
    </section>

    <!-- Social links -->
    <section>
      <h2 class="text-xl font-display uppercase tracking-widest text-gold mb-4 flex items-center gap-3">
        <span class="inline-block w-2 h-2 bg-gold rotate-45"></span>
        Connect
      </h2>
      <div class="flex flex-wrap gap-3">
        {[
          { href: 'https://github.com/hydai', label: 'GitHub' },
          { href: 'https://x.com/hydai_tw', label: 'X (Twitter)' },
          { href: 'https://www.youtube.com/@hydai', label: 'YouTube' },
          { href: 'https://www.facebook.com/hungyingdai', label: 'Facebook' },
          { href: 'mailto:hydai@hyd.ai', label: 'Email' },
        ].map(({ href, label }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-4 py-2 text-sm font-body uppercase tracking-wider border-2 border-gold text-gold hover:bg-gold hover:text-obsidian transition-colors"
          >
            {label}
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
