---
import TagList from './TagList.astro';

interface Props {
  title: string;
  date: Date;
  tags?: string[];
  description?: string;
  slug: string;
}

const { title, date, tags = [], description, slug } = Astro.props;

const formattedDate = `${date.getUTCFullYear()} 年 ${date.getUTCMonth() + 1} 月 ${date.getUTCDate()} 日`;
---

<article
  class="card group p-6"
>
  <a href={`/${slug}/`} class="block">
    <h2
      class="text-xl font-semibold text-text group-hover:text-accent transition-colors leading-snug"
    >
      {title}
    </h2>
  </a>
  <div class="mt-2 flex items-center gap-2 text-sm font-mono text-muted">
    <time datetime={date.toISOString()}>{formattedDate}</time>
  </div>
  {tags.length > 0 && (
    <div class="mt-3">
      <TagList tags={tags} small />
    </div>
  )}
  {description && (
    <p class="mt-3 text-sm text-muted leading-relaxed line-clamp-2">
      {description}
    </p>
  )}
</article>
