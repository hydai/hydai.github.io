---
import TagList from './TagList.astro';

interface Props {
  title: string;
  date: Date;
  tags?: string[];
  description?: string;
  slug: string;
}

const { title, date, tags = [], description, slug } = Astro.props;

const formattedDate = `${date.getUTCFullYear()} 年 ${date.getUTCMonth() + 1} 月 ${date.getUTCDate()} 日`;
---

<article
  class="deco-card deco-corners group p-6 transition-all hover:-translate-y-2 hover:shadow-[0_8px_32px_rgba(212,175,55,0.15)]"
>
  <a href={`/${slug}/`} class="block">
    <h2
      class="text-xl font-display uppercase tracking-widest text-champagne group-hover:text-gold transition-colors leading-snug"
    >
      {title}
    </h2>
  </a>
  <div class="mt-2 flex items-center gap-2 text-sm font-body uppercase tracking-wide text-pewter">
    <time datetime={date.toISOString()}>{formattedDate}</time>
  </div>
  {tags.length > 0 && (
    <div class="mt-3">
      <TagList tags={tags} small />
    </div>
  )}
  {description && (
    <p class="mt-3 text-sm text-pewter leading-relaxed line-clamp-2">
      {description}
    </p>
  )}
</article>
