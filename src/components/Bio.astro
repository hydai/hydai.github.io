---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={['flex items-center', compact ? 'gap-4' : 'gap-6']}>
  <img
    src="/images/avatar.jpg"
    alt="hydai"
    class:list={[
      'rounded-full object-cover border-2 border-gray-200 dark:border-accent-cyan/30',
      compact ? 'w-14 h-14' : 'w-20 h-20',
    ]}
  />
  <div>
    <h2
      class:list={[
        'font-bold text-gray-900 dark:text-text-primary',
        compact ? 'text-lg' : 'text-xl',
      ]}
    >
      hydai
    </h2>
  </div>
</div>
