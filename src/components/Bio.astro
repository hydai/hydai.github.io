---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={['flex items-center', compact ? 'gap-4' : 'gap-6']}>
  <!-- Avatar -->
  <div class:list={[
    'rounded-full border-2 border-border overflow-hidden shrink-0',
    compact ? 'w-16 h-16' : 'w-24 h-24',
  ]}>
    <img
      src="/images/avatar.jpg"
      alt="hydai"
      class:list={[
        'object-cover',
        compact ? 'w-16 h-16' : 'w-24 h-24',
      ]}
    />
  </div>
  <div>
    <h2
      class:list={[
        'font-semibold text-text',
        compact ? 'text-lg' : 'text-xl',
      ]}
    >
      hydai
    </h2>
  </div>
</div>
