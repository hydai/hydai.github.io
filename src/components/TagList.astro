---
import { tagSlug } from '../lib/utils';

interface Props {
  tags: string[];
  small?: boolean;
}

const { tags, small = false } = Astro.props;
---

<div class="flex flex-wrap gap-2">
  {
    tags.map((tag) => (
      <a
        href={`/tags/${tagSlug(tag)}/`}
        class:list={[
          'inline-block rounded-full bg-elevated text-muted transition-colors hover:bg-accent/15 hover:text-accent',
          small ? 'px-2.5 py-0.5 text-xs' : 'px-3 py-1 text-sm',
        ]}
      >
        #{tag}
      </a>
    ))
  }
</div>
