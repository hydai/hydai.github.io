---
interface Props {
  tags: string[];
  small?: boolean;
}

const { tags, small = false } = Astro.props;
---

<div class="flex flex-wrap gap-2">
  {
    tags.map((tag) => (
      <a
        href={`/tags/${tag}/`}
        class:list={[
          'inline-block rounded-full font-mono transition-colors',
          'bg-purple-100 text-purple-700 hover:bg-purple-200',
          'dark:bg-accent-purple/10 dark:text-accent-purple dark:hover:bg-accent-purple/20',
          small ? 'px-2 py-0.5 text-xs' : 'px-3 py-1 text-sm',
        ]}
      >
        #{tag}
      </a>
    ))
  }
</div>
