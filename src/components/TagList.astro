---
interface Props {
  tags: string[];
  small?: boolean;
}

const { tags, small = false } = Astro.props;
---

<div class="flex flex-wrap gap-2">
  {
    tags.map((tag) => (
      <a
        href={`/tags/${tag}/`}
        class:list={[
          'inline-block font-body uppercase tracking-wider border border-gold/50 text-gold transition-colors hover:bg-gold hover:text-obsidian',
          small ? 'px-2 py-0.5 text-xs' : 'px-3 py-1 text-sm',
        ]}
      >
        #{tag}
      </a>
    ))
  }
</div>
