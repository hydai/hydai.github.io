---
interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl?: string;
}

const { currentPage, totalPages, baseUrl = '/' } = Astro.props;

function pageUrl(page: number): string {
  if (page === 1) return baseUrl;
  return `${baseUrl}page/${page}/`;
}
---

{
  totalPages > 1 && (
    <nav class="flex items-center justify-center gap-2 mt-12" aria-label="Pagination">
      {currentPage > 1 && (
        <a
          href={pageUrl(currentPage - 1)}
          class="px-4 py-2 text-sm rounded-lg border border-border text-muted hover:bg-elevated hover:text-text transition-colors"
        >
          &larr; Prev
        </a>
      )}

      {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
        <a
          href={pageUrl(page)}
          class:list={[
            'w-10 h-10 flex items-center justify-center text-sm rounded-lg transition-colors',
            page === currentPage
              ? 'bg-accent text-bg font-semibold'
              : 'border border-border text-muted hover:bg-elevated hover:text-text',
          ]}
          aria-current={page === currentPage ? 'page' : undefined}
        >
          {page}
        </a>
      ))}

      {currentPage < totalPages && (
        <a
          href={pageUrl(currentPage + 1)}
          class="px-4 py-2 text-sm rounded-lg border border-border text-muted hover:bg-elevated hover:text-text transition-colors"
        >
          Next &rarr;
        </a>
      )}
    </nav>
  )
}
